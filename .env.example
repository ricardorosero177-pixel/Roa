# ---- Dominio público (cambia a tu dominio cuando lo tengas) ----
NEXT_PUBLIC_SITE_URL=https://roa.vercel.app

# ---- Supabase (para guardar y listar cotizaciones) ----
# Crea un proyecto gratis en https://supabase.com y pega aquí las claves.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# La service role es secreta: NO la expongas en el cliente. Solo servidor.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Panel de administración (/admin) ----
ADMIN_PASSWORD=cambia-esta-clave

# ---- Marketing / analítica (opcional, se activan con consentimiento) ----
# Google Tag Manager (recomendado: gestiona Google Ads + GA4 desde un solo lugar)
NEXT_PUBLIC_GTM_ID=
# Google Analytics 4 (si no usas GTM)
NEXT_PUBLIC_GA4_ID=
# ID de conversión de Google Ads (AW-XXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Meta Pixel (tu pixel actual de RÖA es 923996053718970)
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Verificación de Google Search Console ----
# Pega aquí el código del método "etiqueta HTML" de Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
